# Copy to .env and fill in what you use: cp .env.example .env
# .env is git-ignored. A variable set in your shell overrides the file.

# --- Ollama or vLLM (any OpenAI-compatible URL); used by --llm openai --------------------------
CIA_OPENAI_BASE_URL=http://localhost:11434/v1
CIA_OPENAI_MODEL=gemma4:26b-mlx
# CIA_OPENAI_API_KEY=            # only if your vLLM endpoint needs one
CIA_OPENAI_MAX_TOKENS=8192       # reasoning models need room; 2048 cut gemma4 off once (bench, PR 2.5)

# --- OpenRouter (hosted open models); used by --llm openrouter ---------------------------------
# Prompts leave the machine: synthetic data only. Free models are rate-limited.
OPENROUTER_API_KEY=
CIA_OPENROUTER_MODEL=google/gemma-4-31b-it:free

# --- Amazon Bedrock; used by --llm bedrock ------------------------------------------------------
# CIA_BEDROCK_MODEL_ID=
# AWS_REGION=

# Agent service (make agent; src/cia/service.py)
CIA_AGENT_LLM=fake               # fake (rule model) | openrouter | openai | bedrock
CIA_AGENT_MODEL=                 # e.g. google/gemma-4-26b-a4b-it with openrouter
CIA_START_DELAY=60s              # wait after an HR event before investigating
CIA_QUIET_PERIOD=14d             # after a disable; any use restores
CIA_EVENT_SECRET=                # when set, events need X-CIA-Signature: sha256=<HMAC of the body>
CIA_MONITOR_URL=http://127.0.0.1:8787
CIA_AGENT_URL=http://127.0.0.1:8790

# Slack (PR 4.4; app manifest: infra/slack/manifest.yaml). Unset: messages go to the console.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Talk to the bot (week 5): openrouter by default when OPENROUTER_API_KEY is set; off = cards only
# CIA_CHAT_LLM=openrouter
# CIA_CHAT_MODEL=google/gemma-4-26b-a4b-it
CIA_SLACK_CHANNEL=
CIA_SLACK_APPROVERS=             # Slack member IDs, comma-separated; empty: nobody may approve
